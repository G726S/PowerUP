# Single key -- either name works, GOOGLE_API_KEY takes priority if both are set.
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here

# Optional: multiple keys, comma-separated, for automatic failover once one
# hits its daily quota. Overrides the single-key vars above if set.
# GOOGLE_API_KEYS=key_one,key_two,key_three
